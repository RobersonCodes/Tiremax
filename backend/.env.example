DATABASE_URL=postgresql://user:password@host:5432/tiremax
DIRECT_URL=postgresql://user:password@host:5432/tiremax
JWT_SECRET=your-secret-here
JWT_EXPIRES_IN=7d
PORT=3001
NODE_ENV=production
SUPER_ADMIN_EMAIL=roberson_sl@hotmail.com

# Usado para montar o link de "esqueci minha senha" enviado por e-mail
FRONTEND_URL=https://app.tiremax.com.br

# Já usadas pelo email.service.js (welcome/trial) — reaproveitadas no reset de senha
RESEND_API_KEY=
EMAIL_FROM=TireMax ERP <onboarding@resend.dev>

# Token da conta MASTER no Focus NFe (não é o certificado do cliente).
# Cada tenant precisa ter empresa cadastrada no painel do Focus NFe com
# seu próprio CNPJ e certificado A1 antes de conseguir emitir nota.
FOCUS_NFE_TOKEN=

# Logos em armazenamento permanente (Cloudflare R2). Obrigatório na hospedagem.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=tiremax-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://<bucket-domain>
