generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT (Borracharia) ────────────────────────────────────────────────────
model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  cnpj         String?
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  city         String?
  state        String?
  zipCode      String?  @map("zip_code")
  logo         String?
  primaryColor String   @default("#f5c800") @map("primary_color")
  openHours    String?  @map("open_hours")
  plan         String   @default("TRIAL")
  status       String   @default("ACTIVE")
  trialEndsAt  DateTime? @map("trial_ends_at")

  // ─── Config fiscal (emissão de nota via Focus NFe) ───
  regimeTributario   String?  @map("regime_tributario") // MEI | SIMPLES_NACIONAL | LUCRO_PRESUMIDO | LUCRO_REAL
  inscricaoMunicipal String?  @map("inscricao_municipal")
  itemListaServico   String?  @map("item_lista_servico") // código LC 116 (ex: 14.01 p/ borracharia)
  cnaeCode           String?  @map("cnae_code")
  aliquotaIss        Float?   @map("aliquota_iss")
  focusNfeEmpresaId  String?  @map("focus_nfe_empresa_id") // referência da empresa cadastrada no painel do Focus NFe
  fiscalEnvironment  String   @default("homologacao") @map("fiscal_environment") // homologacao | producao
  fiscalEnabled      Boolean  @default(false) @map("fiscal_enabled")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users              User[]
  clients            Client[]
  vehicles           Vehicle[]
  categories         Category[]
  products           Product[]
  sales              Sale[]
  services           Service[]
  stockMovements     StockMovement[]
  invoices           Invoice[]
  payments           Payment[]
  accountsReceivable AccountReceivable[]
  accountsPayable    AccountPayable[]

  @@map("tenants")
}

// ─── USER ────────────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  email     String
  password  String
  role      String   @default("EMPLOYEE")
  avatar    String?
  phone     String?
  active    Boolean  @default(true)
  resetToken       String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  sales            Sale[]
  servicesCreated  Service[] @relation("CreatedBy")
  servicesAssigned Service[] @relation("AssignedTo")

  @@unique([tenantId, email])
  @@map("users")
}

// ─── CLIENT ──────────────────────────────────────────────────────────────────
model Client {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  name         String
  document     String?
  documentType String?   @map("document_type")
  email        String?
  phone        String?
  whatsapp     String?
  address      String?
  city         String?
  state        String?
  zipCode      String?   @map("zip_code")
  birthDate    DateTime? @map("birth_date")
  notes        String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  vehicles Vehicle[]
  sales    Sale[]
  services Service[]
  invoices Invoice[]

  @@unique([tenantId, document])
  @@map("clients")
}

// ─── VEHICLE ─────────────────────────────────────────────────────────────────
model Vehicle {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  clientId  String   @map("client_id")
  plate     String
  brand     String
  model     String
  year      Int
  color     String?
  fuelType  String?  @map("fuel_type")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  client   Client    @relation(fields: [clientId], references: [id])
  services Service[]

  @@unique([tenantId, plate])
  @@map("vehicles")
}

// ─── CATEGORY ────────────────────────────────────────────────────────────────
model Category {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@map("categories")
}

// ─── PRODUCT ─────────────────────────────────────────────────────────────────
model Product {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  code        String
  name        String
  description String?
  categoryId  String?  @map("category_id")
  brand       String?
  unit        String   @default("UN")
  costPrice   Float    @map("cost_price")
  salePrice   Float    @map("sale_price")
  stock       Int      @default(0)
  minStock    Int      @default(5) @map("min_stock")
  maxStock    Int?     @map("max_stock")
  location    String?
  barcode     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  saleItems      SaleItem[]
  serviceItems   ServiceItem[]
  stockMovements StockMovement[]

  @@unique([tenantId, code])
  @@map("products")
}

// ─── SALE ─────────────────────────────────────────────────────────────────────
model Sale {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  number        Int
  clientId      String?  @map("client_id")
  userId        String   @map("user_id")
  status        String   @default("PENDING")
  subtotal      Float
  discount      Float    @default(0)
  total         Float
  paymentMethod String   @map("payment_method")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  client   Client?    @relation(fields: [clientId], references: [id])
  user     User       @relation(fields: [userId], references: [id])
  items    SaleItem[]
  invoice  Invoice?
  payments Payment[]

  @@unique([tenantId, number])
  @@map("sales")
}

// ─── SALE ITEM ───────────────────────────────────────────────────────────────
model SaleItem {
  id        String @id @default(uuid())
  saleId    String @map("sale_id")
  productId String @map("product_id")
  quantity  Int
  unitPrice Float  @map("unit_price")
  discount  Float  @default(0)
  total     Float

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

// ─── SERVICE ─────────────────────────────────────────────────────────────────
model Service {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  number       Int
  clientId     String    @map("client_id")
  vehicleId    String?   @map("vehicle_id")
  createdById  String    @map("created_by_id")
  assignedToId String?   @map("assigned_to_id")
  status       String    @default("OPEN")
  type         String
  description  String?
  diagnosis    String?
  laborCost    Float     @default(0) @map("labor_cost")
  partsCost    Float     @default(0) @map("parts_cost")
  total        Float
  estimatedAt  DateTime? @map("estimated_at")
  completedAt  DateTime? @map("completed_at")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  client     Client        @relation(fields: [clientId], references: [id])
  vehicle    Vehicle?      @relation(fields: [vehicleId], references: [id])
  createdBy  User          @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo User?         @relation("AssignedTo", fields: [assignedToId], references: [id])
  items      ServiceItem[]
  invoice    Invoice?

  @@unique([tenantId, number])
  @@map("services")
}

// ─── SERVICE ITEM ────────────────────────────────────────────────────────────
model ServiceItem {
  id          String  @id @default(uuid())
  serviceId   String  @map("service_id")
  productId   String? @map("product_id")
  description String
  quantity    Int     @default(1)
  unitPrice   Float   @map("unit_price")
  total       Float

  service Service  @relation(fields: [serviceId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@map("service_items")
}

// ─── STOCK MOVEMENT ──────────────────────────────────────────────────────────
model StockMovement {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  productId String   @map("product_id")
  type      String
  quantity  Int
  reason    String
  reference String?
  unitCost  Float?   @map("unit_cost")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("stock_movements")
}

// ─── INVOICE ─────────────────────────────────────────────────────────────────
model Invoice {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  number    String?
  type      String    @default("NFSE") // NFSE | NFCE | NFE
  saleId    String?   @unique @map("sale_id")
  serviceId String?   @unique @map("service_id")
  clientId  String    @map("client_id")
  status    String    @default("DRAFT") // DRAFT | PROCESSING | ISSUED | ERROR | CANCELLED
  amount    Float
  focusRef      String?  @map("focus_ref")     // referência retornada pelo Focus NFe p/ consulta de status
  pdfUrl        String?  @map("pdf_url")
  xmlUrl        String?  @map("xml_url")
  errorMessage  String?  @map("error_message")
  issueDate DateTime? @map("issue_date")
  dueDate   DateTime? @map("due_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  sale    Sale?    @relation(fields: [saleId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
  client  Client   @relation(fields: [clientId], references: [id])

  @@map("invoices")
}

// ─── PAYMENT ─────────────────────────────────────────────────────────────────
model Payment {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  saleId      String?  @map("sale_id")
  method      String
  amount      Float
  reference   String?
  processedAt DateTime @default(now()) @map("processed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  sale   Sale?  @relation(fields: [saleId], references: [id])

  @@map("payments")
}

// ─── ACCOUNT RECEIVABLE ──────────────────────────────────────────────────────
model AccountReceivable {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  description String
  clientId    String?   @map("client_id")
  amount      Float
  dueDate     DateTime  @map("due_date")
  paidAt      DateTime? @map("paid_at")
  paidAmount  Float?    @map("paid_amount")
  status      String    @default("PENDING")
  reference   String?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("accounts_receivable")
}

// ─── ACCOUNT PAYABLE ─────────────────────────────────────────────────────────
model AccountPayable {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  description String
  supplier    String?
  amount      Float
  dueDate     DateTime  @map("due_date")
  paidAt      DateTime? @map("paid_at")
  paidAmount  Float?    @map("paid_amount")
  status      String    @default("PENDING")
  category    String?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("accounts_payable")
}
